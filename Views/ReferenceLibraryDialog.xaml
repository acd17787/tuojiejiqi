<Window x:Class="AIRenderer.Views.ReferenceLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AIRenderer.Views"
        Title="参考图库" Height="520" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="参考图库" FontSize="16" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center"/>
            <TextBlock Text=" — 点击图片将其作为输入图使用" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Image Grid -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <Grid>
                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasImages, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock Text="📁" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="还没有保存的参考图" FontSize="14" Foreground="#AAA" HorizontalAlignment="Center"/>
                    <TextBlock Text="点击下方「上传并保存」来添加" FontSize="12" Foreground="#CCC" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Images -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <ItemsControl ItemsSource="{Binding Images}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="150" Height="160" Margin="6" Background="#FAFAFA"
                                        BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#4A90D9"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Image Grid.Row="0" Source="{Binding Thumbnail}" Stretch="Uniform"
                                               Margin="4" MouseLeftButtonUp="Image_Click" Tag="{Binding}"/>
                                        <CheckBox Grid.Row="0"
                                                  IsChecked="{Binding IsSelected}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Top"
                                                  Margin="8"
                                                  Visibility="{Binding DataContext.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        <Grid Grid.Row="1" Background="#F0F0F0">
                                            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#555"
                                                       Padding="6,4" TextTrimming="CharacterEllipsis"/>
                                            <Button Content="×" HorizontalAlignment="Right"
                                                    Width="18" Height="18" FontSize="11"
                                                    Background="#E05555" Foreground="White" BorderThickness="0"
                                                    Cursor="Hand" Tag="{Binding}" Click="DeleteImage_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="UploadBtn" Content="上传并保存到图库" Click="UploadBtn_Click"
                    Background="#43A047" Foreground="White" BorderThickness="0"
                    Padding="16,9" FontSize="13" Cursor="Hand" Margin="0,0,8,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="添加选中" Click="AddSelectedBtn_Click"
                    Background="#4A90D9" Foreground="White" BorderThickness="0"
                    Padding="16,9" FontSize="13" Cursor="Hand" Margin="0,0,8,0"
                    Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BoolToVis}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="关闭" Click="CloseBtn_Click"
                    Background="#E0E0E0" Foreground="#333" BorderThickness="0"
                    Padding="16,9" FontSize="13" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
